{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Aegis AI",
  "version": "0.1.0-alpha",
  "identifier": "com.aegis.companion",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../apps/desktop-ui",
    "beforeBuildCommand": "npm run build --prefix ../apps/desktop-ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../apps/desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aegis AI Overlay",
        "width": 750,
        "height": 700,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "shadow": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}

